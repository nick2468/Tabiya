{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabiya",
  "version": "1.10.9",
  "identifier": "com.nick.london-trainer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Tabiya",
        "width": 1400,
        "height": 980,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Nicholas Walker",
    "copyright": "Copyright (c) 2026 Nicholas Walker",
    "shortDescription": "Chess opening repertoire trainer",
    "longDescription": "Study, drill and play your opening repertoires, with a Stockfish sparring partner.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "compression": "zlib"
      }
    }
  }
}
