{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "London Trainer",
  "version": "1.0.0",
  "identifier": "com.nick.london-trainer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "London Trainer",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "London System trainer",
    "longDescription": "Study, drill and play the London System, with a Stockfish sparring partner.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
