{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Repertoire Trainer window is allowed to do: keep its own progress file, its marker and its courses in its own data folder, keep one second copy of the progress file under the user's local data folder so that deleting the data folder cannot lose everything, read the older folder named after the bundle identifier so the data can be carried across once, install and remove courses in the new folder, look at the window's own browser profile folder and the one it used before it was renamed so the trainee can be told which is which, and let the trainee pick a file to import or a place to export. The old folder is readable and not writable, which is what makes the migration a copy. Nothing may remove the second copy: it is written blind and read only when the main file has gone.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer/progress.json"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/**"
        },
        {
          "path": "$APPDATA/progress.json"
        },
        {
          "path": "$APPDATA/courses/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DATA/Repertoire Trainer/progress.marker.json"
        },
        {
          "path": "$LOCALDATA/Repertoire Trainer Data/progress.backup.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer/progress.json"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/**"
        },
        {
          "path": "$DATA/Repertoire Trainer/progress.marker.json"
        },
        {
          "path": "$LOCALDATA/Repertoire Trainer Data/progress.backup.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer"
        },
        {
          "path": "$DATA/Repertoire Trainer/progress.json"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/**"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/progress.json"
        },
        {
          "path": "$APPDATA/courses"
        },
        {
          "path": "$APPDATA/courses/*"
        },
        {
          "path": "$APPDATA/courses/**"
        },
        {
          "path": "$DATA/Repertoire Trainer/progress.marker.json"
        },
        {
          "path": "$LOCALDATA/Repertoire Trainer Data"
        },
        {
          "path": "$LOCALDATA/Repertoire Trainer Data/progress.backup.json"
        },
        {
          "path": "$LOCALDATA/Repertoire Trainer Data/WebView2"
        },
        {
          "path": "$APPLOCALDATA"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        },
        {
          "path": "$LOCALDATA/Repertoire Trainer Data"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer/courses"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        },
        {
          "path": "$APPDATA/courses"
        },
        {
          "path": "$APPDATA/courses/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer/progress.json"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$LOCALDATA/Repertoire Trainer Data/progress.backup.json"
        }
      ]
    }
  ]
}
