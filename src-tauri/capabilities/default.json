{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Tabiya window is allowed to do. It keeps its own progress file, its marker and its courses in its own data folder, $DATA/Tabiya, which is the only folder here it may write to. It keeps one second copy of the progress file under the user's local data folder, in $LOCALDATA/Tabiya Data, so that deleting the data folder cannot lose everything. It installs and removes courses in the new folder, picks up courses dropped into it, looks at the window's own browser profile folder and the two it used before so the trainee can be told which is which, and lets the trainee pick a file to import or a place to export. TWO OLDER GENERATIONS OF DATA FOLDER ARE READABLE AND NEITHER IS WRITABLE, which is what makes the migration a copy rather than a move: $DATA/Repertoire Trainer, where the data lived between phases 15 and 47, and $APPDATA, the folder named after the bundle identifier, where it lived before phase 15. A trainee arriving from either is carried across once, the newest one first. Write access to an old folder is the one grant that would turn a migration into something that can lose a file, so neither has it. Nothing may remove the second copy either: it is written blind and read only when the main file has gone.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$DATA/Tabiya/progress.json"
        },
        {
          "path": "$DATA/Tabiya/courses/**"
        },
        {
          "path": "$DATA/Repertoire Trainer/progress.json"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/**"
        },
        {
          "path": "$APPDATA/progress.json"
        },
        {
          "path": "$APPDATA/courses/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DATA/Tabiya/progress.marker.json"
        },
        {
          "path": "$LOCALDATA/Tabiya Data/progress.backup.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$DATA/Tabiya/progress.json"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DATA/Tabiya/courses/*"
        },
        {
          "path": "$DATA/Tabiya/courses/*/*"
        },
        {
          "path": "$DATA/Tabiya/courses/**"
        },
        {
          "path": "$DATA/Tabiya/progress.marker.json"
        },
        {
          "path": "$LOCALDATA/Tabiya Data/progress.backup.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$DATA/Tabiya"
        },
        {
          "path": "$DATA/Tabiya/progress.json"
        },
        {
          "path": "$DATA/Tabiya/courses"
        },
        {
          "path": "$DATA/Tabiya/courses/*"
        },
        {
          "path": "$DATA/Tabiya/courses/**"
        },
        {
          "path": "$DATA/Repertoire Trainer"
        },
        {
          "path": "$DATA/Repertoire Trainer/progress.json"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/**"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/progress.json"
        },
        {
          "path": "$APPDATA/courses"
        },
        {
          "path": "$APPDATA/courses/*"
        },
        {
          "path": "$APPDATA/courses/**"
        },
        {
          "path": "$DATA/Tabiya/progress.marker.json"
        },
        {
          "path": "$LOCALDATA/Tabiya Data"
        },
        {
          "path": "$LOCALDATA/Tabiya Data/progress.backup.json"
        },
        {
          "path": "$LOCALDATA/Tabiya Data/WebView2"
        },
        {
          "path": "$LOCALDATA/Repertoire Trainer Data/WebView2"
        },
        {
          "path": "$APPLOCALDATA"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$DATA/Tabiya"
        },
        {
          "path": "$DATA/Tabiya/courses"
        },
        {
          "path": "$DATA/Tabiya/courses/*"
        },
        {
          "path": "$LOCALDATA/Tabiya Data"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$DATA/Tabiya/courses"
        },
        {
          "path": "$DATA/Tabiya/courses/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        },
        {
          "path": "$APPDATA/courses"
        },
        {
          "path": "$APPDATA/courses/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$DATA/Tabiya/progress.json"
        },
        {
          "path": "$DATA/Tabiya/courses/*"
        },
        {
          "path": "$DATA/Tabiya/courses/*/*"
        },
        {
          "path": "$DATA/Tabiya/courses/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$LOCALDATA/Tabiya Data/progress.backup.json"
        }
      ]
    }
  ]
}
