{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the London Trainer window is allowed to do: keep its own progress file, and let the trainee pick a file to import or a place to export.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/*" }, { "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/*" }, { "path": "$HOME/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/*" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/*" }]
    }
  ]
}
