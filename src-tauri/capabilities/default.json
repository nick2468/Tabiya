{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Repertoire Trainer window is allowed to do: keep its own progress file, read courses dropped into its own courses folder, and let the trainee pick a file to import or a place to export.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$APPDATA/progress.json"
        },
        {
          "path": "$APPDATA/courses/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$APPDATA/progress.json"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/progress.json"
        },
        {
          "path": "$APPDATA/courses"
        },
        {
          "path": "$APPDATA/courses/*"
        },
        {
          "path": "$APPDATA/courses/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$APPDATA/courses"
        },
        {
          "path": "$APPDATA/courses/*"
        }
      ]
    }
  ]
}
