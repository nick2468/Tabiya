{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Repertoire Trainer window is allowed to do: keep its own progress file and courses in its own data folder, read the older folder named after the bundle identifier so the data can be carried across once, install and remove courses in the new folder, and let the trainee pick a file to import or a place to export. The old folder is readable and not writable, which is what makes the migration a copy.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer/progress.json"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/**"
        },
        {
          "path": "$APPDATA/progress.json"
        },
        {
          "path": "$APPDATA/courses/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer/progress.json"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer"
        },
        {
          "path": "$DATA/Repertoire Trainer/progress.json"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/**"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/progress.json"
        },
        {
          "path": "$APPDATA/courses"
        },
        {
          "path": "$APPDATA/courses/*"
        },
        {
          "path": "$APPDATA/courses/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer/courses"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        },
        {
          "path": "$APPDATA/courses"
        },
        {
          "path": "$APPDATA/courses/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$DATA/Repertoire Trainer/progress.json"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/*/*"
        },
        {
          "path": "$DATA/Repertoire Trainer/courses/**"
        }
      ]
    }
  ]
}
